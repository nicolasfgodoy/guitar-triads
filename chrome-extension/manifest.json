{
  "manifest_version": 3,
  "name": "Tríades na Guitarra - Cifra Club Helper",
  "version": "1.0",
  "description": "Veja shapes de tríades e voicings de guitarra diretamente nos acordes das cifras do Cifra Club.",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.cifraclub.com.br/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}
